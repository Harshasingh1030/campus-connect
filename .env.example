# CampusConnect - Frontend Environment Configuration Template
# Copy this file to .env.local for local overrides.
# NOTE: Never store AWS secret keys, access keys, or sensitive backend credentials in this file.

# Switch between isolated Demo Services (localStorage) and AWS Serverless REST API
# Set to 'true' to use the demo adapter, or 'false' to connect to live API Gateway
VITE_USE_MOCK_DATA=true

# Amazon API Gateway Endpoint (Required when VITE_USE_MOCK_DATA=false)
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=https://api.campusconnect.example.edu/v1

# AWS Configuration Identifiers (Public IDs only, no secrets!)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_S3_POSTER_BUCKET=campusconnect-posters-prod
